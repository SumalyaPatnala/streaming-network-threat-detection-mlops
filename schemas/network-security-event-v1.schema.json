{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streaming-network-threat-detection-mlops/schemas/network-security-event-v1.schema.json",
  "title": "Network Security Event",
  "description": "Authenticated event envelope for normalized network-flow inference; score values remain uncalibrated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "features",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "features": {
      "$ref": "network-flow-model-input-v1.schema.json#/properties/features"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
