index=security source=network-threat-detection sourcetype=_json kind=model_prediction
| sort 0 - _time
| table _time tenant_id event_id class_label prediction model_score score_semantics model_id model_version correlation_id evidence_refs response_recommendation

index=security source=network-threat-detection sourcetype=_json kind=incident_triage
| sort 0 - _time
| table _time tenant_id event_id decision reviewed_by model_id model_version correlation_id prediction evidence_refs

index=security source=network-threat-detection sourcetype=_json kind=model_prediction prediction=1
| stats latest(_time) as predicted_at latest(class_label) as class_label latest(model_score) as model_score latest(model_id) as model_id latest(model_version) as model_version latest(correlation_id) as correlation_id values(evidence_refs) as evidence_refs by tenant_id event_id
| join type=left tenant_id event_id [
    search index=security source=network-threat-detection sourcetype=_json kind=incident_triage
    | stats latest(decision) as triage_decision latest(reviewed_by) as reviewed_by latest(correlation_id) as triage_correlation_id by tenant_id event_id
]
| where isnull(triage_decision)
| table predicted_at tenant_id event_id class_label model_score model_id model_version correlation_id evidence_refs triage_correlation_id
| sort 0 - predicted_at
