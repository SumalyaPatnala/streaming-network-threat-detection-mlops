{
  "annotations": {
    "list": []
  },
  "description": "Inference, ingestion, and aggregate feature-drift monitoring. Configure a Prometheus data source before import.",
  "editable": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (model_id, outcome) (rate(threat_detection_inference_requests_total[5m]))",
          "legendFormat": "{{model_id}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Inference throughput by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (model_id, le) (rate(threat_detection_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model_id}} p95",
          "refId": "A"
        }
      ],
      "title": "Inference latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "threat_detection_feature_drift_psi",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "title": "Maximum feature PSI across tenant windows",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (outcome) (rate(threat_detection_ingested_events_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Ingestion event rate",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["threat-detection", "mlops"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Streaming Network Threat Detection",
  "uid": "network-threat-detection",
  "version": 1
}
